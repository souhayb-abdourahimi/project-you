# Copy to .env.local and fill in. Never commit .env or .env.local.
# Only EXPO_PUBLIC_* variables reach the client bundle: they must be public by design.

# Supabase project (Settings → API). The anon key is public and protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (Supabase Edge Function secrets, never in the app):
# SUPABASE_SERVICE_ROLE_KEY=
# AI_PROVIDER_API_KEY=

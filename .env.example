# Copy to .env.local and fill in. Never commit .env or .env.local.
# Only EXPO_PUBLIC_* variables reach the client bundle: they must be public by design.

# Supabase project (Dashboard → Project Settings → API Keys).
# The publishable key (sb_publishable_…) is public: data is protected by Auth + RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative, used only if the publishable key is empty:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Never here: sb_secret_… / service_role keys belong to Edge Function secrets only.
# AI_PROVIDER_API_KEY=

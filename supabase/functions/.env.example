# Edge Function secrets: names only, never values in the repository.
# Fill a copy OUTSIDE the repository (e.g. ~/projectyou-fn.env), then:
#   npx supabase@latest secrets set --env-file ~/projectyou-fn.env && rm ~/projectyou-fn.env
# None of these ever goes in an EXPO_PUBLIC_ variable, the PWA bundle or the app.

# places-nearby (D-051): Geoapify Places, free plan (3,000 credits a day, no card).
# Empty or absent: the function uses OpenStreetMap (Overpass) only.
GEOAPIFY_API_KEY=

# calendar-feed (D-049): AES-256-GCM key, `openssl rand -base64 32`. Never change it once set.
CALENDAR_FEED_KEY=

# analyze-meal (D-048): ordered provider chain, e.g. openai,cloudflare or cloudflare.
MEAL_VISION_PROVIDER=
MEAL_VISION_MODEL=
OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
